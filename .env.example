# ---------------------------------------------------------------------------
# ERP Tenant Frontend — переменные окружения
# Скопируйте файл: cp .env.example .env.local
# ---------------------------------------------------------------------------

# Базовый URL backend API (используется в src/lib/axiosInstance.ts).
# Обязательная переменная. Без слэша в конце.
# Запросы идут с withCredentials: true — для куки-авторизации API должен быть
# на том же домене (или отдавать корректные CORS/SameSite заголовки).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Опционально (только для локальной разработки)
# ---------------------------------------------------------------------------

# Порт dev-сервера Next.js (по умолчанию 3000): npm run dev -- -p $PORT
# PORT=3000
